{
  "name": "easynote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "bash dev.sh",
    "dev:client": "vite --host 127.0.0.1 --port 5174",
    "build": "npm run check && vite build && npm run build:ai",
    "build:ai": "node scripts/clean-ai.mjs && tsc -p tsconfig.ai.json",
    "check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p tsconfig.ai.json",
    "test": "npm run test:api && npm run test:ai",
    "test:api": "node --import tsx --test test/api.test.ts",
    "test:ai": "node --import tsx --test test/ai.test.ts",
    "test:scripts": "node --test test/scripts.test.mjs",
    "test:ui": "playwright test",
    "ai:setup": "npm run --silent build:ai && node dist/ai/index.js setup",
    "ai:mcp": "npm run --silent build:ai && node dist/ai/index.js mcp",
    "deploy": "bash deploy.sh",
    "deploy:check": "bash deploy.sh --check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "dompurify": "^3.3.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "image-dimensions": "^2.5.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260914.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.55.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.9",
    "miniflare": "5.20260911.1-alpha",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^12.0.0"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260911.1": true
  }
}
